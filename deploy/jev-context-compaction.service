[Unit]
Description=Jev context compaction bridge for Claude Code
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/typesafe/env
Environment=FAST_JEV_LISTEN=127.0.0.1:8787
Environment=FAST_JEV_PAUSE_FILE=%h/.local/state/fast-jev-compaction/usage-exhausted
ExecStart=%h/.local/bin/jev-context-compaction-server
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/fast-jev-compaction
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=64M
TasksMax=32

[Install]
WantedBy=default.target
